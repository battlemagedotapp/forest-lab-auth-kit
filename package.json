{
  "name": "@forest-lab/auth-kit",
  "version": "0.9.0",
  "description": "Forest Lab's auth kit: headless Better Auth workflows with reactive Convex freshness, and prepaid billing (Dodo Payments). A fork of @strawdev/auth-client.",
  "homepage": "https://github.com/battlemagedotapp/forest-lab-auth-kit#readme",
  "bugs": "https://github.com/battlemagedotapp/forest-lab-auth-kit/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/battlemagedotapp/forest-lab-auth-kit.git"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./convex": {
      "types": "./dist/convex/index.d.ts",
      "import": "./dist/convex/index.js"
    },
    "./convex/component": {
      "types": "./dist/convex/component.d.ts",
      "import": "./dist/convex/component.js"
    },
    "./better-auth": {
      "types": "./dist/better-auth/index.d.ts",
      "import": "./dist/better-auth/index.js"
    },
    "./billing": {
      "types": "./dist/billing/index.d.ts",
      "import": "./dist/billing/index.js"
    },
    "./convex/billing": {
      "types": "./dist/convex/billing.d.ts",
      "import": "./dist/convex/billing.js"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "react-hook-form": "7.88.0"
  },
  "peerDependencies": {
    "@convex-dev/better-auth": "~0.12.5",
    "@tanstack/react-query": "~5.102.8",
    "better-auth": "~1.6.22",
    "convex": "^1.45.0",
    "react": "~19.2.0",
    "zod": "~4.6.4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    }
  }
}
